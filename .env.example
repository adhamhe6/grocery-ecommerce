# Orchard Row — environment for `docker compose up`. Copy to `.env` (or run `make env`, which also generates secrets).
# Nothing in this file is a real credential. Never commit a populated .env.

# ---- required secrets (`make env` fills these with random values) -------------------------------------------------
DJANGO_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
POSTGRES_PASSWORD=

# ---- hosts / URLs ------------------------------------------------------------------------------------------------
# The public address of the storefront. The storefront proxies /api and /media to the backend, so this is the only origin
# browsers talk to.
SITE_URL=http://localhost:3000
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# ---- local plain-HTTP trial only ---------------------------------------------------------------------------------
# Production runs behind HTTPS and must leave these at their secure defaults (cookies Secure, HSTS, HTTPS redirect).
SECURE_COOKIES=false
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0

# ---- payments -----------------------------------------------------------------------------------------------------
# demo   = simulated sandbox page; NEVER moves money. Requires PAYMENTS_ALLOW_DEMO=true. For demonstrations and tests only.
# stripe = real provider; set the two keys below. The Stripe adapter has NOT been verified against a live Stripe account in
#          this repository — see docs/security.md and docs/commerce-workflows.md before enabling it.
PAYMENT_PROVIDER=demo
PAYMENTS_ALLOW_DEMO=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- email --------------------------------------------------------------------------------------------------------
# The default writes emails to the backend log instead of sending them.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Orchard Row <orders@example.invalid>

# ---- misc ---------------------------------------------------------------------------------------------------------
TIME_ZONE=UTC
LOG_LEVEL=INFO
